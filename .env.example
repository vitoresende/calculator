# ==============================================================================
# Full-Stack Calculator Configuration
# Copy this file to .env and adjust the values to fit your local or cloud setup
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Cloud Platform & Deployment Settings
# ------------------------------------------------------------------------------
# Your Google Cloud Project ID (used by Cloud Build and Firebase)
GCP_PROJECT_ID=your-gcp-project-id

# Google Cloud Run region
GCP_REGION=us-central1

# Google Cloud Run service name
CLOUD_RUN_SERVICE_NAME=calculator-backend

# ------------------------------------------------------------------------------
# Backend Configuration (Go REST API)
# ------------------------------------------------------------------------------
# Port for the Go server to bind to (Cloud Run assigns this dynamically via $PORT)
PORT=8080

# Allowed origins for CORS (e.g. your Firebase Hosting URL, or * for local testing)
ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# Frontend Configuration (React.js + Vite + TypeScript)
# ------------------------------------------------------------------------------
# Base URL for the calculator API:
# - Local Docker Compose / Vite proxy: /api/v1 or http://localhost:8080/api/v1
# - Production Firebase Hosting: https://calculator-backend-<hash>-<region>.a.run.app/api/v1
VITE_API_BASE_URL=/api/v1

# ------------------------------------------------------------------------------
# Firebase Hosting Configuration
# ------------------------------------------------------------------------------
# Firebase Project ID (found in Firebase Console)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: custom Firebase Hosting site target (if using multisite)
FIREBASE_HOSTING_SITE=your-calculator-site
