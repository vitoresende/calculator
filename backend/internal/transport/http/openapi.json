{
  "openapi": "3.0.3",
  "info": {
    "title": "Full-Stack Cloud Calculator API",
    "version": "1.0.0",
    "description": "High-precision arithmetic microservice providing endpoints for standard and scientific calculator operations with strict JSON validation and domain error mapping."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Environment Server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Service Health Check",
        "description": "Returns operational status of the calculator backend service.",
        "responses": {
          "200": {
            "description": "Service is healthy and ready to accept requests.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "summary": "Versioned Health Check",
        "description": "Returns operational status under /api/v1 namespace.",
        "responses": {
          "200": {
            "description": "Service is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/calculate": {
      "post": {
        "summary": "Execute Arithmetic Calculation",
        "description": "Performs binary (add, subtract, multiply, divide, pow) or unary (sqrt, percentage) arithmetic operations with float normalization and strict error boundaries.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalculateRequest"
              },
              "examples": {
                "addition": {
                  "summary": "Addition",
                  "value": {
                    "operation": "add",
                    "a": 10.5,
                    "b": 20.3
                  }
                },
                "division": {
                  "summary": "Division",
                  "value": {
                    "operation": "divide",
                    "a": 100,
                    "b": 8
                  }
                },
                "sqrt": {
                  "summary": "Square Root",
                  "value": {
                    "operation": "sqrt",
                    "a": 144
                  }
                },
                "exponentiation": {
                  "summary": "Exponentiation (Pow)",
                  "value": {
                    "operation": "pow",
                    "a": 2,
                    "b": 10
                  }
                },
                "percentage": {
                  "summary": "Percentage",
                  "value": {
                    "operation": "percentage",
                    "a": 50
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Calculation executed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalculateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: Malformed JSON, missing required fields, or unrecognized attributes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity: Semantic domain failure (division by zero, negative square root, imaginary domain).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error: Unexpected calculation failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CalculateRequest": {
        "type": "object",
        "required": ["operation", "a"],
        "properties": {
          "operation": {
            "type": "string",
            "description": "Operation name or symbol",
            "enum": ["add", "+", "subtract", "-", "multiply", "*", "divide", "/", "pow", "^", "sqrt", "percentage", "%"]
          },
          "a": {
            "type": "number",
            "description": "First operand (or solitary operand for unary operations like sqrt/percentage)"
          },
          "b": {
            "type": "number",
            "description": "Second operand (required for binary operations: add, subtract, multiply, divide, pow)"
          }
        },
        "additionalProperties": false
      },
      "CalculateResponse": {
        "type": "object",
        "required": ["result", "operation", "operands"],
        "properties": {
          "result": {
            "type": "number",
            "description": "Computed arithmetic result with normalized floating-point precision"
          },
          "operation": {
            "type": "string",
            "description": "The normalized operation executed"
          },
          "operands": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "Operands supplied to the calculation"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "example": "DIVISION_BY_ZERO"
          },
          "message": {
            "type": "string",
            "example": "division by zero is not allowed"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": ["status", "service"],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "calculator-backend"
          }
        }
      }
    }
  }
}
